# MongoDB Atlas connection string (see NaijaStyle Atelier setup for the cluster pattern you already use)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/lekki-tides?retryWrites=true&w=majority

PORT=4000

# Paystack (test keys while building, live keys only in production, never committed)
PAYSTACK_SECRET_KEY=sk_test
PAYSTACK_PUBLIC_KEY=pk_test

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL Paystack redirects the guest back to after paying
APP_BASE_URL=http://localhost:5173

# Shared secret the owner dashboard sends as the x-admin-key header.
# Placeholder until real owner login + 2FA is built.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Resend (confirmation emails) — sign up at resend.com, verify your sending
# domain there, then set EMAIL_FROM to an address on that domain.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Lekki Tides <bookings@yourdomain.com>"

# Cloudinary (owner dashboard "Photos" tab — upload shortlet/boat images with
# no code). You can reuse the same Cloudinary account/cloud name as NaijaStyle
# Atelier, or create a separate one for this project — either works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
